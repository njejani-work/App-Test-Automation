{
  "name": "app-tests",
  "private": true,
  "description": "Android app test automation for several apps: one shared toolkit (toolkit/) and one small folder per app (apps/<id>).",
  "type": "module",
  "workspaces": [
    "toolkit",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:unit": "npm run test:unit --workspaces --if-present",
    "mcp:install": "npm --prefix mcp install",
    "mcp:test": "npm --prefix mcp test",
    "mcp:inspect": "npm --prefix mcp run inspect",
    "dashboard:ui:install": "npm --prefix toolkit/dashboard/ui install",
    "dashboard:ui:dev": "npm --prefix toolkit/dashboard/ui run dev",
    "dashboard:ui:build": "npm --prefix toolkit/dashboard/ui run build",
    "dashboard:ui:test": "npm --prefix toolkit/dashboard/ui test"
  }
}
