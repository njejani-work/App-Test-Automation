{
  "name": "egenome.ai",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^8.7.2",
    "dotenv": "^18.0.9",
    "webdriverio": "^10.1.0",
    "xpath": "^0.0.36"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.js",
    "appium": "appium",
    "appium:setup": "appium driver install uiautomator2",
    "locators:watch": "node ../../toolkit/locators/capture.mjs watch",
    "locators:attach": "node ../../toolkit/locators/capture.mjs watch --attach",
    "locators:crawl": "node ../../toolkit/locators/capture.mjs crawl",
    "locators:list": "node ../../toolkit/locators/capture.mjs list",
    "locators:pages": "node ../../toolkit/locators/capture.mjs pages",
    "test:login": "wdio run ./wdio.conf.js --spec ./test/specs/regression/01-login.e2e.js",
    "dashboard": "node ../../toolkit/dashboard/cli.mjs --open",
    "dashboard:build": "node ../../toolkit/dashboard/cli.mjs",
    "dashboard:demo": "node test/dashboard/fixtures.mjs",
    "test:dashboard:unit": "node --test \"test/dashboard/unit/*.test.mjs\"",
    "test:dashboard:page": "playwright test -c test/dashboard/playwright.config.mjs",
    "test:unit": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=@apptest/toolkit/dashboard/unit-report.mjs --test-reporter-destination=stdout \"test/unit/**/*.test.mjs\" \"test/dashboard/unit/*.test.mjs\"",
    "test:unit:coverage": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=@apptest/toolkit/dashboard/unit-report.mjs --test-reporter-destination=stdout --experimental-test-coverage --test-coverage-lines=75 --test-coverage-exclude=\"**/*.test.mjs\" --test-coverage-include=\"../../toolkit/layout/*.js\" --test-coverage-include=\"test/pageobjects/**/*.js\" --test-coverage-include=\"../../toolkit/pageobjects/*.js\" --test-coverage-include=\"../../toolkit/wdio/*.js\" --test-coverage-include=\"test/data/*.js\" --test-coverage-include=\"../../toolkit/dashboard/**/*.js\" --test-coverage-include=\"../../toolkit/dashboard/**/*.mjs\" --test-coverage-include=\"../../toolkit/testing/*.mjs\" --test-coverage-include=\"../../toolkit/locators/lib/parser.mjs\" \"test/unit/**/*.test.mjs\" \"test/dashboard/unit/*.test.mjs\"",
    "test:unit:error-demo": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=@apptest/toolkit/dashboard/unit-report.mjs --test-reporter-destination=stdout test/unit/error-demo/error-demo.mjs",
    "mcp:install": "npm --prefix mcp install",
    "mcp:test": "npm --prefix mcp test",
    "mcp:inspect": "npm --prefix mcp run inspect",
    "mcp:pack": "npx -y @anthropic-ai/mcpb@2.1.2 pack mcp/extension mcp/egenome-tests.mcpb",
    "deliverables": "node scripts/deliverables/build.mjs",
    "test:smoke": "wdio run ./wdio.conf.js --suite smoke",
    "test:regression": "wdio run ./wdio.conf.js --suite regression",
    "test:layout": "wdio run ./wdio.conf.js --suite layout",
    "test:extended": "wdio run ./wdio.conf.js --suite extended",
    "layout:generate": "node scripts/layout/generate.mjs",
    "layout:baseline": "node ../../toolkit/scripts/run-with-env.mjs LAYOUT_UPDATE=true -- wdio run ./wdio.conf.js --suite layout",
    "layout:accept": "node scripts/layout/accept.mjs"
  }
}
