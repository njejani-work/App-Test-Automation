{
  "name": "wikipedia-app-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Compile the Wikipedia Android app from its Git repository into an APK, then run an Appium smoke suite against it.",
  "scripts": {
    "build:apk": "node scripts/run-bash.mjs scripts/build-apk.sh",
    "appium:setup": "appium driver install uiautomator2",
    "doctor": "node scripts/doctor.mjs",
    "test:smoke": "wdio run ./wdio.conf.js --suite smoke",
    "test:tour": "wdio run ./wdio.conf.js --suite tour",
    "dashboard": "node ../../toolkit/dashboard/cli.mjs --open",
    "smoke": "npm run build:apk && npm run test:smoke",
    "wdio": "wdio run ./wdio.conf.js",
    "appium": "appium",
    "locators:crawl": "node ../../toolkit/locators/capture.mjs crawl",
    "locators:watch": "node ../../toolkit/locators/capture.mjs watch",
    "locators:attach": "node ../../toolkit/locators/capture.mjs watch --attach",
    "locators:list": "node ../../toolkit/locators/capture.mjs list",
    "locators:pages": "node ../../toolkit/locators/capture.mjs pages",
    "dashboard:build": "node ../../toolkit/dashboard/cli.mjs",
    "test:unit": "node --test --test-reporter=spec \"test/unit/*.test.mjs\""
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/junit-reporter": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^8.7.2",
    "dotenv": "^18.0.9",
    "webdriverio": "^10.1.0",
    "xpath": "^0.0.36"
  }
}
