# Copy to .env and adjust. .env is git-ignored; this file is safe to commit.
# No secrets are needed: the app is public and the smoke suite does not log in.

# --- Step 1: compile (scripts/build-apk.sh reads these from the environment) ---
# Repository and ref (branch, tag or FULL commit hash) to build
APP_REPO=https://github.com/njejani-work/apps-android-wikipedia.git
APP_REF=HEAD
# Extra Gradle options, e.g. to lower memory use on small machines:
# GRADLE_ARGS=-Dorg.gradle.jvmargs=-Xmx3g --max-workers=2

# --- Step 2: test ---
# Leave empty to test the newest APK in out/. Set to test a specific file.
APK_PATH=
# Leave empty when only one emulator/phone is connected (see: adb devices)
DEVICE_UDID=
DEVICE_NAME=Android Emulator

# --- Test data ---
SEARCH_TERM=Albert Einstein

# --- Builds ---
# How many built APKs to keep in out/ (each debug APK is ~140 MB)
KEEP_BUILDS=5

# --- Dashboard (reports/index.html) ---
# all = screenshot at the end of every test, failed = only failures
DASHBOARD_SCREENSHOTS=all
# A test slower than this (ms) gets a warning. Leave empty to use test/budgets.json (per test, or its default);
# when set, it replaces the budgets.json default but not the limits of single tests listed there
DASHBOARD_SLOW_MS=
# How many past runs the dashboard keeps (older ones are deleted)
DASHBOARD_KEEP_RUNS=30
# Screen recording of each test: failed = keep only failures, all, off
DASHBOARD_VIDEO=failed
# Memory, frame stats and launch time per test (on/off). On = Appium allows adb_shell (frame stats)
DASHBOARD_PERF=on
# Record the full response of every API call the app makes (on/off). Off = address, status and time only
DASHBOARD_API_BODIES=on
# A single API call slower than this (ms) or bigger than this (KB) gets a warning, for APIs without their own
# limits. test/budgets.json (api.default / api.endpoints) has the same limits plus p95 budgets and replaces these.
DASHBOARD_SLOW_API_MS=2000
DASHBOARD_LARGE_API_KB=500

# --- Run details (optional; shown under "Run details" on the dashboard) ---
# local or ci (set automatically to ci when the CI variable is set)
# TEST_ENV=local
# What started the run, if not you on this PC (CI systems are detected by themselves), and a name to show instead of your user name
# DASHBOARD_TRIGGER=nightly script
# DASHBOARD_STARTED_BY=Nishant
